{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx20-query-builder": {
      "projectType": "library",
      "root": "projects/ngx20-query-builder",
      "sourceRoot": "projects/ngx20-query-builder/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx20-query-builder/tsconfig.lib.json",
            "project": "projects/ngx20-query-builder/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx20-query-builder/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ngx20-query-builder/src/test.ts",
            "tsConfig": "projects/ngx20-query-builder/tsconfig.spec.json",
            "karmaConfig": "projects/ngx20-query-builder/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": ".eslintrc.js",
            "lintFilePatterns": ["projects/ngx20-query-builder/**/*.ts"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
