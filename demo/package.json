{
  "name": "demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --raw \"gulp copyLibWatch\" \"ng serve\"",
    "build": "npm run build:aot && npm run build:jit && npm run copy-editor",
    "build:aot": "ng build --configuration production",
    "build:jit": "ng build",
    "test": "ng test",
    "lint": "npx --prefix .. eslint -c ../.eslintrc.js \"src/**/*.ts\" \"e2e/**/*.ts\" --max-warnings=0",
    "e2e": "ng e2e",
    "copy-editor": "copyfiles \"./editor/**/*\" dist",
    "copy-lib": "npm install ../dist/ngx20-query-builder",
    "prebuild:aot": "npm run copy-lib",
    "prebuild:jit": "npm run copy-lib"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.16",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.16",
    "@angular/compiler": "20.3.16",
    "@angular/core": "20.3.16",
    "@angular/forms": "20.3.16",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.16",
    "@angular/platform-browser-dynamic": "20.3.16",
    "@angular/router": "20.3.16",
    "core-js": "^3.33.2",
    "demo": "file:",
    "ngx20-query-builder": "file:../dist/ngx20-query-builder",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.14",
    "@angular/cli": "20.3.14",
    "@angular/compiler-cli": "20.3.16",
    "@angular/language-service": "20.3.16",
    "@types/jasmine": "^3.3.9",
    "@types/jasminewd2": "^2.0.6",
    "@types/node": "^22.13.1",
    "codelyzer": "^6.0.2",
    "concurrently": "^5.1.0",
    "copyfiles": "^1.2.0",
    "gulp": "^4.0.2",
    "jasmine-core": "^5.1.1",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "protractor": "~7.0.0",
    "rimraf": "^2.6.1",
    "spck-embed": "^0.1.0",
    "ts-node": "~8.0.2",
    "tslint": "~6.1.0",
    "typescript": "5.8.3"
  }
}
